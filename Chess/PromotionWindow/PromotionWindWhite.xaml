<local:PromWindBase x:Class="Chess.PromotionWindow.PromotionWindWhite"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Chess.PromotionWindow"
        Title="PromotionWindow" Height="120" Width="40" WindowStyle="None" ResizeMode="NoResize">
    <Grid>
        <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
            <Image Name="Queen" HorizontalAlignment="Center" VerticalAlignment="Center" Width="30" Height="30" MouseLeftButtonDown="SelectFigure">
                <Image.Source>/PhotosOfFigures/Chess_qlt60.png</Image.Source>   
            </Image>

            <Image Name="Rook" HorizontalAlignment="Center" VerticalAlignment="Center" Width="30" Height="30" MouseLeftButtonDown="SelectFigure">
                <Image.Source>/PhotosOfFigures/Chess_rlt60.png</Image.Source>
            </Image>

            <Image Name="Bishop" HorizontalAlignment="Center" VerticalAlignment="Center" Width="30" Height="30" MouseLeftButtonDown="SelectFigure">
                <Image.Source>/PhotosOfFigures/Chess_blt60.png</Image.Source>
            </Image>

            <Image Name="Knight" HorizontalAlignment="Center" VerticalAlignment="Center" Width="30" Height="30" MouseLeftButtonDown="SelectFigure">
                <Image.Source>/PhotosOfFigures/Chess_nlt60.png</Image.Source>
            </Image>
        </StackPanel>

    </Grid>
</local:PromWindBase>
