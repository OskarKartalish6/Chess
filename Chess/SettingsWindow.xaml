<Window x:Class="Chess.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Chess"
        mc:Ignorable="d"
        Title="SettingsWindow" Height="400" Width="400" ResizeMode="CanMinimize" Background="#FF1C1C1C">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="30px"/>
                <RowDefinition Height="40px"/>
            </Grid.RowDefinitions>
            <TextBlock Text="♟️ Bullet"
                   Grid.Row="0"
                   VerticalAlignment="Center" Foreground="WhiteSmoke"/>

            <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="5">
                <Button Content="1 min" Tag="1|0" Width="80" Margin="15,0,15,0" Click="TimeButton_Click"/>
                <Button Content="1 | 1" Tag="1|1" Width="80" Margin="15,0,15,0" Click="TimeButton_Click"/>
                <Button Content="2 | 1" Tag="2|1" Width="80" Margin="15,0,15,0" Click="TimeButton_Click"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="30px"/>
                <RowDefinition Height="40px"/>
            </Grid.RowDefinitions>
            <TextBlock Text="⚡ Blitz"
           Grid.Row="0"
           VerticalAlignment="Center" Foreground="WhiteSmoke"/>

            <StackPanel Grid.Row="1"
            Orientation="Horizontal"
            HorizontalAlignment="Center"
            Margin="5">
                <Button Content="3 min" Tag="3|0" Width="80" Margin="15,0,15,0" Click="TimeButton_Click"/>
                <Button Content="3 | 2" Tag="3|2" Width="80" Margin="15,0,15,0" Click="TimeButton_Click"/>
                <Button Content="5 min" Tag="5|0" Width="80" Margin="15,0,15,0" Click="TimeButton_Click"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="30px"/>
                <RowDefinition Height="40px"/>
            </Grid.RowDefinitions>
            <TextBlock Text="⏰ Rapid"
           Grid.Row="0"
           VerticalAlignment="Center" Foreground="WhiteSmoke"/>

            <StackPanel Grid.Row="1"
            Orientation="Horizontal"
            HorizontalAlignment="Center"
            Margin="5">
                <Button Content="10 min" Tag="10|0" Width="80" Margin="15,0,15,0" Click="TimeButton_Click"/>
                <Button Content="15 | 10" Tag="15|10" Width="80" Margin="15,0,15,0" Click="TimeButton_Click"/>
                <Button Content="30 min" Tag="30|0" Width="80" Margin="15,0,15,0" Click="TimeButton_Click"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="30px"/>
                <RowDefinition Height="23px"/>
            </Grid.RowDefinitions>
            <TextBlock Text="🤖 AI"
           Grid.Row="0"
           VerticalAlignment="Center" Foreground="WhiteSmoke"/>
            <CheckBox x:Name="AiCheckBox" Content="" HorizontalAlignment="Right" Foreground="WhiteSmoke" Margin="0,7,0,0" Checked="AiCheckBox_Checked" Unchecked="AiCheckBox_Unchecked"/>
            <ComboBox x:Name="AiLevelComboBox" Grid.Row="2" SelectionChanged="AiLevelComboBox_SelectionChanged">
                <ComboBoxItem Content="easy" Tag="1"/>
                <ComboBoxItem Content="medium" Tag="2"/>
                <ComboBoxItem Content="hard" Tag="3"/>
            </ComboBox>
        </Grid>
    </Grid>

</Window>
